+"""Hand completed recordings to the optional host-side GitHub uploader."""
+
+import datetime
+import json
+import os
+from pathlib import Path
+import tempfile
+import uuid
+
+
+def checkout_root():
+    configured = os.environ.get('NOVA_1811_STACK_ROOT')
+    if configured:
+        return Path(configured).resolve()
+    root = Path.cwd().resolve()
+    for candidate in (root, *root.parents):
+        if (candidate / 'ros2_ws/src/vehicle_ui_hub').is_dir():
+            return candidate
+    return None
+
+
+def queue_recording(bag_path, root=None):
+    """Queue a completed bag when setup enabled uploads; never upload here.
+
+    The ROS process runs in a container. Paths below the mounted checkout are
+    written relative to that checkout so the host service can find the same bag.
+    """
+    root = Path(root).resolve() if root is not None else checkout_root()
+    if root is None or not (root / '.rosbag-upload' / 'enabled').is_file():
+        return None
+    bag = Path(bag_path).resolve(strict=True)
+    if not bag.is_dir() or not (bag / 'metadata.yaml').is_file():
+        raise ValueError('The completed bag directory or metadata.yaml is missing.')
+    try:
+        relative = bag.relative_to(root)
+    except ValueError as exc:
+        raise ValueError('The bag is outside the mounted checkout; upload it from the Karbon terminal.') from exc
+    pending = root / '.rosbag-upload' / 'pending'
+    if not pending.is_dir():
+        raise OSError('The upload queue is missing. Run the GitHub upload setup on Karbon again.')
+
+    job_id = uuid.uuid4().hex
+    job = {'version': 1, 'id': job_id, 'source_type': 'checkout', 'source': relative.as_posix(),
+           'created': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+    descriptor, temporary = tempfile.mkstemp(prefix='.new-', suffix='.json', dir=pending)
+    try:
+        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
+            json.dump(job, stream)
+            stream.flush()
+            os.fsync(stream.fileno())
+        # The GUI may run as root in Docker while the uploader runs as the
+        # checkout owner on the host. The owner must be able to read the job.
+        if os.geteuid() == 0:
+            owner = root.stat()
+            os.chown(temporary, owner.st_uid, owner.st_gid)
+        os.replace(temporary, pending / (job_id + '.json'))
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+    return job_id

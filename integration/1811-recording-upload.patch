+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from github_upload_queue import queue_recording
+
+
+class UploadQueueTest(unittest.TestCase):
+    def test_disabled_setup_does_not_queue(self):
+        with tempfile.TemporaryDirectory() as directory:
+            self.assertIsNone(queue_recording(Path(directory) / 'bag', root=directory))
+            self.assertFalse((Path(directory) / '.rosbag-upload').exists())
+
+    def test_completed_bag_is_queued_with_checkout_relative_path(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            pending = root / '.rosbag-upload' / 'pending'
+            pending.mkdir(parents=True)
+            (pending.parent / 'enabled').write_text('{}')
+            bag = root / 'recordings' / 'test bag'
+            bag.mkdir(parents=True)
+            (bag / 'metadata.yaml').write_text('test')
+            job_id = queue_recording(bag, root=root)
+            job = json.loads((pending / (job_id + '.json')).read_text())
+            self.assertEqual(job['source_type'], 'checkout')
+            self.assertEqual(job['source'], 'recordings/test bag')
+            self.assertTrue((bag / 'metadata.yaml').exists())
+
+    def test_outside_checkout_is_reported_and_not_queued(self):
+        with tempfile.TemporaryDirectory() as directory, tempfile.TemporaryDirectory() as other:
+            root = Path(directory)
+            pending = root / '.rosbag-upload' / 'pending'
+            pending.mkdir(parents=True)
+            (pending.parent / 'enabled').write_text('{}')
+            bag = Path(other) / 'bag'
+            bag.mkdir()
+            (bag / 'metadata.yaml').write_text('test')
+            with self.assertRaisesRegex(ValueError, 'outside the mounted checkout'):
+                queue_recording(bag, root=root)
+            self.assertFalse(list(pending.iterdir()))
+
+
+if __name__ == '__main__':
+    unittest.main()
